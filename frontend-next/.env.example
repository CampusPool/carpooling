MOBILITY_API_ORIGIN=http://127.0.0.1:18080
# Optional browser key for a future Google Maps JS overlay; never commit a secret.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_TRUSTED_SHARE_ORIGIN=
# Ola Maps: opt-in only. Backend matching remains OSRM until full migration is verified.
# Never commit real API credentials. OLA_MAPS_BROWSER_KEY is inherently visible to an authorized browser SDK user.
NEXT_PUBLIC_MAP_PROVIDER=google
OLA_MAPS_ENABLED=0
OLA_MAPS_API_KEY=
OLA_MAPS_BROWSER_KEY=
