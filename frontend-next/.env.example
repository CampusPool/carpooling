MOBILITY_API_ORIGIN=http://127.0.0.1:18080
# Optional browser key for a future Google Maps JS overlay; never commit a secret.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_TRUSTED_SHARE_ORIGIN=
# Local defaults use Google/OSRM. For the student Ola preview, build with NEXT_PUBLIC_MAP_PROVIDER=ola and configure Laravel with MOBILITY_ROUTING_PROVIDER=ola.
# Keep credentials out of Git. Student static maps use the server key; interactive SDK maps require a separate restricted browser key.
NEXT_PUBLIC_MAP_PROVIDER=google
OLA_MAPS_ENABLED=0
OLA_MAPS_API_KEY=
OLA_MAPS_BROWSER_KEY=
