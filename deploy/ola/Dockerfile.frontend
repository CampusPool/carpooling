FROM node:24-bookworm-slim AS builder
WORKDIR /app
COPY frontend-next/package.json frontend-next/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend-next/ ./
# Never place an Ola API key in build arguments or the browser bundle.
ARG MOBILITY_API_ORIGIN=http://api-web:8080
ENV NEXT_PUBLIC_MAP_PROVIDER=ola \
    NEXT_PUBLIC_CANONICAL_DEMO=1 \
    MOBILITY_API_ORIGIN=${MOBILITY_API_ORIGIN} \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm prune --omit=dev --no-audit --no-fund

FROM node:24-bookworm-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_MAP_PROVIDER=ola NEXT_PUBLIC_CANONICAL_DEMO=1 \
    MOBILITY_API_ORIGIN=http://api-web:8080
WORKDIR /app
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/next.config.mjs ./next.config.mjs
USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
